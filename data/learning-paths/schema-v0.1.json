{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0verme/ruankao-cockpit/blob/main/data/learning-paths/schema-v0.1.json",
  "title": "Learning Path v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "path_id",
    "version",
    "status",
    "title",
    "taxonomy_version",
    "source",
    "ordering",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "learning-path/v0.1" },
    "path_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "approved", "deprecated"] },
    "title": { "type": "string", "minLength": 1 },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "ordering": { "$ref": "#/$defs/ordering" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "archive_name", "archive_size_bytes", "archive_sha256", "description"],
      "properties": {
        "type": { "const": "user_provided_checkin_archive" },
        "archive_name": { "type": "string", "minLength": 1 },
        "archive_size_bytes": { "type": "integer", "minimum": 1 },
        "archive_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "date_semantics", "order_semantics"],
      "properties": {
        "basis": { "type": "string", "minLength": 1 },
        "date_semantics": { "type": "string", "minLength": 1 },
        "order_semantics": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "order",
        "source_date",
        "source_file",
        "source_title",
        "topic_ids",
        "mapping_status",
        "mapping_confidence",
        "mapping_notes",
        "knowledge_point_titles"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^checkin-[0-9]{3}$" },
        "order": { "type": "integer", "minimum": 1 },
        "source_date": { "type": "string", "format": "date" },
        "source_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "source_title": { "type": "string", "minLength": 1 },
        "original_topic_title": { "type": "string", "minLength": 1 },
        "topic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+\\.[A-Z0-9_]+\\.[A-Z0-9_]+$" }
        },
        "mapping_status": { "enum": ["exact", "partial", "split", "merge", "unmapped", "non_learning"] },
        "mapping_confidence": { "enum": ["high", "medium", "low", null] },
        "mapping_notes": { "type": "string", "minLength": 1 },
        "knowledge_point_titles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "mapping_group_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      },
      "allOf": [
        {
          "if": { "properties": { "mapping_status": { "const": "exact" } } },
          "then": { "properties": { "topic_ids": { "minItems": 1, "maxItems": 1 }, "mapping_confidence": { "enum": ["high", "medium", "low"] } } }
        },
        {
          "if": { "properties": { "mapping_status": { "const": "partial" } } },
          "then": { "properties": { "topic_ids": { "minItems": 1, "maxItems": 1 }, "mapping_confidence": { "enum": ["high", "medium", "low"] } } }
        },
        {
          "if": { "properties": { "mapping_status": { "const": "split" } } },
          "then": { "properties": { "topic_ids": { "minItems": 2 }, "mapping_confidence": { "enum": ["high", "medium", "low"] } } }
        },
        {
          "if": { "properties": { "mapping_status": { "const": "merge" } } },
          "then": {
            "required": ["mapping_group_id"],
            "properties": { "topic_ids": { "minItems": 1, "maxItems": 1 }, "mapping_confidence": { "enum": ["high", "medium", "low"] } }
          }
        },
        {
          "if": { "properties": { "mapping_status": { "const": "unmapped" } } },
          "then": { "properties": { "topic_ids": { "maxItems": 0 }, "mapping_confidence": { "const": "low" } } }
        },
        {
          "if": { "properties": { "mapping_status": { "const": "non_learning" } } },
          "then": { "properties": { "topic_ids": { "maxItems": 0 }, "mapping_confidence": { "const": null }, "knowledge_point_titles": { "maxItems": 0 } } }
        }
      ]
    }
  }
}

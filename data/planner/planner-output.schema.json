{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0verme/ruankao-cockpit/blob/main/data/planner/planner-output.schema.json",
  "title": "Planner Output v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planner_policy",
    "input_snapshot_schema_version",
    "as_of",
    "timezone",
    "generated_for_local_date",
    "horizon",
    "days",
    "explain_traces"
  ],
  "properties": {
    "schema_version": {"const": "planner-output/v0.1"},
    "planner_policy": {"$ref": "#/$defs/plannerPolicy"},
    "input_snapshot_schema_version": {"const": "planner-input/v0.1"},
    "as_of": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "generated_for_local_date": {"type": "string", "format": "date"},
    "horizon": {"$ref": "#/$defs/horizon"},
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/planDay"}
    },
    "explain_traces": {
      "type": "array",
      "items": {"$ref": "#/$defs/explainTrace"}
    }
  },
  "$defs": {
    "plannerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1}
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "day_count"],
      "properties": {
        "unit": {"const": "local_calendar_days"},
        "day_count": {"const": 7}
      }
    },
    "targetRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^review/(?:topic/[A-Za-z0-9][A-Za-z0-9._:-]*|question/[A-Za-z0-9][A-Za-z0-9._:-]*/[A-Za-z0-9][A-Za-z0-9._:-]*|case_capability/[A-Za-z0-9][A-Za-z0-9._:-]*)$"
    },
    "planTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_type",
        "target_kind",
        "target_ref",
        "planned_minutes",
        "explain_trace_id"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_type": {"const": "review"},
        "target_kind": {"const": "review_item"},
        "target_ref": {"$ref": "#/$defs/targetRef"},
        "planned_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "explain_trace_id": {"type": "string", "minLength": 1}
      }
    },
    "unmetDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demand_id",
        "demand_type",
        "target_kind",
        "target_ref",
        "requested_minutes",
        "explain_trace_id"
      ],
      "properties": {
        "demand_id": {"type": "string", "minLength": 1},
        "demand_type": {"const": "review"},
        "target_kind": {"const": "review_item"},
        "target_ref": {"$ref": "#/$defs/targetRef"},
        "requested_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "explain_trace_id": {"type": "string", "minLength": 1}
      }
    },
    "explainTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "subject_kind",
        "subject_id",
        "decision_category",
        "reason_code",
        "planner_policy",
        "input_references",
        "target_kind",
        "target_ref",
        "structured_inputs"
      ],
      "properties": {
        "trace_id": {"type": "string", "minLength": 1},
        "subject_kind": {"enum": ["plan_task", "unmet_demand"]},
        "subject_id": {"type": "string", "minLength": 1},
        "decision_category": {"enum": ["task_scheduled", "demand_unmet"]},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "planner_policy": {"$ref": "#/$defs/plannerPolicy"},
        "input_references": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "^/"}
        },
        "target_kind": {"const": "review_item"},
        "target_ref": {"$ref": "#/$defs/targetRef"},
        "structured_inputs": {"type": "object"},
        "display_message": {"type": "string", "minLength": 1}
      }
    },
    "planDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day_offset",
        "local_date",
        "study_day",
        "capacity_minutes",
        "planned_minutes",
        "remaining_minutes",
        "tasks",
        "unmet_demand"
      ],
      "properties": {
        "day_offset": {"type": "integer", "minimum": 0, "maximum": 6},
        "local_date": {"type": "string", "format": "date"},
        "study_day": {"type": "boolean"},
        "capacity_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "planned_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "remaining_minutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/planTask"}
        },
        "unmet_demand": {
          "type": "array",
          "items": {"$ref": "#/$defs/unmetDemand"}
        }
      }
    }
  }
}

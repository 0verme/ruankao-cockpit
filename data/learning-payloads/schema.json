{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0verme/ruankao-cockpit/blob/main/data/learning-payloads/schema.json",
  "title": "Learning Payload v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "topic_id", "objectives", "core_points", "exam_focus", "source_references"],
  "properties": {
    "schema_version": {"const": "learning-payload/v0.1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "topic_id": {"type": "string", "pattern": "^[A-Z0-9_]+(\\.[A-Z0-9_]+){2}$"},
    "objectives": {"$ref": "#/$defs/objectives"},
    "core_points": {"$ref": "#/$defs/corePoints"},
    "exam_focus": {"$ref": "#/$defs/examFocus"},
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceReference"}
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "corePoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "text", "evidence_refs"],
        "properties": {
          "heading": {"type": "string", "minLength": 1, "maxLength": 80},
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
        }
      }
    },
    "examFocus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 320},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "sourceReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_id", "kind", "display_title", "source_id", "source_commit", "source_path", "source_value", "source_anchor", "confidence"],
          "properties": {
            "reference_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "kind": {"enum": ["textbook_section", "exam_outline"]},
            "display_title": {"type": "string", "minLength": 1},
            "source_id": {"type": "string", "minLength": 1},
            "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_path": {"type": "string", "minLength": 1},
            "source_value": {"type": "string", "minLength": 1},
            "source_anchor": {"type": "string", "minLength": 1},
            "confidence": {"enum": ["high", "medium", "low"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_id", "kind", "display_title", "source_id", "source_commit", "source_path", "source_question_id", "golden_set_record_id", "confidence"],
          "properties": {
            "reference_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "kind": {"const": "golden_set_question"},
            "display_title": {"type": "string", "minLength": 1},
            "source_id": {"type": "string", "minLength": 1},
            "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_path": {"type": "string", "minLength": 1},
            "source_question_id": {"type": "string", "minLength": 1},
            "golden_set_record_id": {"type": "string", "minLength": 1},
            "confidence": {"enum": ["high", "medium", "low"]}
          }
        }
      ]
    }
  }
}

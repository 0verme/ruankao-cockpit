---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Topic-centric 学习工作台 · Browser Presentation' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f8" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
